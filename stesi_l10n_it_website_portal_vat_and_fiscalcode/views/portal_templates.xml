<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="extra_info" inherit_id="website_sale.extra_info">
        <xpath expr="//div[hasclass('s_website_form_field')]" position="after">
            <t t-value="website_sale_order.partner_id.country_id == request.env.ref('base.it')" t-set="is_italian"/>
            <t t-if="is_italian">
                <div class="form-group s_website_form_field col-12 s_website_form_custom s_website_form_required"
                     data-type="char" data-name="Field">
                    <div class="row s_col_no_resize s_col_no_bgcolor">
                        <label class="col-form-label col-sm-auto s_website_form_label " style="width: 200px"
                               for="fiscalcode">
                            <span class="s_website_form_label_content">Codice Fiscale</span>
                            <span class="s_website_form_mark"> *</span>
                        </label>
                        <div class="col-sm">
                            <input type="text" class="form-control s_website_form_input" name="fiscalcode"
                                   required="1" placeholder="" id="fiscalcode" t-att-value="website_sale_order.partner_id.fiscalcode"
                                   t-att-readonly="'1' if website_sale_order.partner_id.fiscalcode else None"/>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <template
        id="portal_my_details"
        name="Add Fiscalcode and Vat in Portal"
        inherit_id="portal.portal_my_details">

        <xpath expr="//div[hasclass('o_portal_details')]/div[1]/div[1]/div[7]" position="after">
            <t t-value="partner.country_id == request.env.ref('base.it')" t-set="is_italian"/>
            <t t-if="is_italian">
                <div t-attf-class="form-group #{error.get('fiscalcode') and 'o_has_error' or ''} col-xl-6">
                    <label class="col-form-label label-optional" for="fiscalcode">Fiscal Code</label>
                    <input
                        type="text"
                        name="fiscalcode"
                        t-attf-class="form-control #{error.get('fiscalcode') and 'is-invalid' or ''}"
                        t-att-value="fiscalcode or partner.fiscalcode"
                        t-att-readonly="None if partner.company_type in ['company'] and (not fiscalcode or not partner.fiscalcode) else '1'"
                        t-att-title="None if partner.can_edit_vat() else 'Changing Fiscal Code is not allowed once document(s) have been issued for your account. Please contact us directly for this operation.'"/>
                </div>
            </t>
<!--            <t>-->
<!--                <div t-attf-class="form-group #{error.get('vat') and 'o_has_error' or ''} col-xl-6">-->
<!--                    <label class="col-form-label label-optional" for="vat">Vat</label>-->
<!--                    <input-->
<!--                        type="text"-->
<!--                        name="vat"-->
<!--                        t-attf-class="form-control #{error.get('vat') and 'is-invalid' or ''}"-->
<!--                        t-att-value="vat or partner.vat"-->
<!--                        t-att-readonly="None if partner.can_edit_vat() and not partner.vat else '1'"-->
<!--                        t-att-title="None if partner.can_edit_vat() else 'Changing Fiscal Code is not allowed once document(s) have been issued for your account. Please contact us directly for this operation.'"/>-->
<!--                </div>-->
<!--            </t>-->
        </xpath>
    </template>
</odoo>
