<?xml version="1.0" ?>
<odoo>


    <record id="account_move_form_sp_fix" model="ir.ui.view">
        <field name="name">account.move.form.sp.fix</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
           <xpath expr="//page[@id='invoice_tab']//field[@name='invoice_line_ids']//field[@name='product_id']" position="after">
               <field name="is_split_payment" invisible="1"/>
           </xpath>

            <xpath expr="//page[@id='aml_tab']//field[@name='line_ids']//field[@name='product_id']" position="after">
               <field name="is_split_payment" invisible="1"/>
           </xpath>

        </field>
    </record>

</odoo>
