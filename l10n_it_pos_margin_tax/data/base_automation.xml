<odoo>
    <data>
        <record model="base.automation" id="auto_update_margin">
            <field name="name">Auto set margin on line</field>
            <field name="model_id" ref="model_pos_order_line"/>
            <field name="trigger">on_create</field>
            <field name="state">code</field>
            <field name="code">records._set_manual_margin_from_lot()</field>
        </record>
   <record model="base.automation" id="auto_update_margin_account">
            <field name="name">Auto set margin on move line from pos</field>
            <field name="model_id" ref="model_account_move_line"/>
            <field name="trigger">on_create</field>
            <field name="state">code</field>
            <field name="code">records._compute_margin_from_pos_session()</field>
        </record>

    </data>
</odoo>
