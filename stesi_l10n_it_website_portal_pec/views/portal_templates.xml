<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="extra_info" inherit_id="website_sale.extra_info">
        <xpath expr="//div[hasclass('s_website_form_field')]" position="after">
            <t t-value="website_sale_order.partner_id.country_id == request.env.ref('base.it')" t-set="is_italian"/>
            <t t-if="is_italian">
                <div class="form-group s_website_form_field col-12 s_website_form_custom "
                     data-type="char" data-name="Field">
                    <div class="row s_col_no_resize s_col_no_bgcolor">
                        <label class="col-form-label col-sm-auto s_website_form_label " style="width: 200px"
                               for="pec_email">
                            <span class="s_website_form_label_content">Pec Email</span>
                            <span class="s_website_form_mark"> *</span>
                        </label>
                        <div class="col-sm">
                            <input type="text" class="form-control s_website_form_input" name="pec_mail"
                                   placeholder="" id="pec_mail" t-att-value="website_sale_order.partner_id.pec_mail"
                                   t-att-readonly="'1' if website_sale_order.partner_id.pec_mail else None"/>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <template
        id="portal_my_details"
        name="Add PEC in Portal"
        inherit_id="portal.portal_my_details">

        <xpath expr="//div[hasclass('o_portal_details')]/div[1]/div[1]/div[7]" position="after">
            <t t-value="partner.country_id == request.env.ref('base.it')" t-set="is_italian"/>
            <t t-if="is_italian">
                <div t-attf-class="form-group #{error.get('pec_mail') and 'o_has_error' or ''} col-xl-6">
                    <label class="col-form-label label-optional" for="pec_mail">PEC</label>
                    <input
                        type="email"
                        name="pec_mail"
                        t-att-readonly="None if partner.company_type in ['company'] and (not pec_mail or not partner.pec_mail) else '1'"
                        t-attf-class="form-control #{error.get('pec_mail') and 'is-invalid' or ''}"
                        t-att-value="pec_mail or partner.pec_mail"
                        t-att-title="None if partner.company_type in ['company'] else 'For change PEC you have to be a Company, if you are, please contact system Administrator.'"/>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
