<?xml version="1.0" ?>
<odoo>


    <template id="l10n_it_fatturapa_out_fix.account_invoice_it_cessionario_committente"
                  inherit_id="l10n_it_fatturapa_out.account_invoice_it_cessionario_committente">
        <xpath
            expr="//CessionarioCommittente/DatiAnagrafici/IdFiscaleIVA[@t-if='not in_eu(partner_id.commercial_partner_id)']"
            position="replace">
            <IdFiscaleIVA t-if="not in_eu(partner_id.commercial_partner_id) and not force_vat">
                <IdPaese
                    t-esc="partner_id.commercial_partner_id.country_id.code"
                />
                <IdCodice>99999999999</IdCodice>
            </IdFiscaleIVA>
        </xpath>
        <xpath
        expr="//CessionarioCommittente/DatiAnagrafici/IdFiscaleIVA[@t-if='in_eu(partner_id.commercial_partner_id) and partner_id.commercial_partner_id.vat']"
        position="replace">
            <IdFiscaleIVA t-if="(in_eu(partner_id.commercial_partner_id) or force_vat) and partner_id.commercial_partner_id.vat">
            <IdPaese
                t-esc="get_vat_country(partner_id.commercial_partner_id.vat)"
            />
            <IdCodice
                t-esc="get_vat_number(partner_id.commercial_partner_id.vat)"
            />
            </IdFiscaleIVA>
        </xpath>

    </template>

    <record id="account_move_form_sp_fix" model="ir.ui.view">
        <field name="name">account.move.form.sp.fix</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_it_fatturapa_out.account_invoice_it_cedente_prestatore" />
        <field name="arch" type="xml">

<xpath expr="//IdFiscaleIVA" position="attributes">
    <attribute name="t-if">partner_id.vat</attribute>
</xpath>
        </field>
    </record>
    <record id="account_move_form_sp_fix2" model="ir.ui.view">
        <field name="name">account.move.form.sp.fix</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_it_fatturapa_out.account_invoice_it_rappresentante_fiscale" />
        <field name="arch" type="xml">

<xpath expr="//IdFiscaleIVA" position="attributes">
    <attribute name="t-if">fatturapa_tax_representative.vat</attribute>
</xpath>
        </field>
    </record>
    <record id="account_move_form_sp_fix2" model="ir.ui.view">
        <field name="name">account.move.form.sp.fix</field>
        <field name="inherit_id" ref="l10n_it_fatturapa_out.account_invoice_it_rappresentante_fiscale" />
        <field name="arch" type="xml">

<xpath expr="//IdFiscaleIVA" position="attributes">
    <attribute name="t-if">fatturapa_tax_representative.vat</attribute>
</xpath>
        </field>
    </record>


        <record id="account_move_form_sp_fix3" model="ir.ui.view">
        <field name="name">account.move.form.sp.fix</field>
        <field name="inherit_id" ref="l10n_it_fatturapa_out.account_invoice_it_cessionario_committente" />
        <field name="arch" type="xml">

<xpath expr="//IdFiscaleIVA" position="attributes">
    <attribute name="t-if">partner_id.company_type == 'company'</attribute>
</xpath>
        </field>
    </record>


           <record id="account_move_form_sp_fix4" model="ir.ui.view">
        <field name="name">account.move.form.sp.fix</field>
        <field name="inherit_id" ref="l10n_it_fatturapa_out.account_invoice_it_terzo_intermediario_soggetto_emittente" />
        <field name="arch" type="xml">

<xpath expr="//IdFiscaleIVA" position="attributes">
    <attribute name="t-if">company_id.fatturapa_sender_partner.vat</attribute>
</xpath>
        </field>
    </record>

</odoo>
