<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_report_registro_iva_per_day" model="ir.actions.report">
        <field name="name">Invoices VAT Registry</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_it_vat_registries.report_registro_iva_per_day</field>
        <field name="report_file">l10n_it_vat_registries.report_registro_iva_per_day</field>
        <field
            name="paperformat_id"
            ref="l10n_it_account.l10n_it_account_a4_landscape"
        />
    </record>

    <!-- <record id="report_registro_iva_per_day" model="ir.ui.view">-->
