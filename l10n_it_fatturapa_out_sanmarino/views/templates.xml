<?xml version="1.0" ?>
<odoo>


    <template id="l10n_it_fatturapa_out_sanmarino.account_invoice_it_cessionario_committente"
                  inherit_id="l10n_it_fatturapa_out.account_invoice_it_cessionario_committente">
        <xpath
            expr="//CessionarioCommittente/DatiAnagrafici/IdFiscaleIVA[@t-if='not in_eu(partner_id.commercial_partner_id)']"
            position="attributes">
            <attribute name="t-if">not in_eu(partner_id.commercial_partner_id) and not force_vat</attribute>

        </xpath>
        <xpath
        expr="//CessionarioCommittente/DatiAnagrafici/IdFiscaleIVA[@t-if='in_eu(partner_id.commercial_partner_id) and partner_id.commercial_partner_id.vat']"
        position="attributes">
            <attribute name="t-if">(in_eu(partner_id.commercial_partner_id) or force_vat) and partner_id.commercial_partner_id.vat</attribute>

        </xpath>

    </template>

</odoo>
