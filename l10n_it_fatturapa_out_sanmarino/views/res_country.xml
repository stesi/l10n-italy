<?xml version="1.0" ?>
<odoo>


    <record id="res_country_fatturapa_out_fix_force_vat" model="ir.ui.view">
        <field name="model">res.country</field>
        <field name="inherit_id" ref="base.view_country_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='country_details']/field[@name='intrastat']" position="after">
                <field name="force_export_vat" string="Force Export Vat in Invoice"/>
            </xpath>
        </field>
    </record>

</odoo>
