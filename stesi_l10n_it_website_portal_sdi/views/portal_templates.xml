<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="address_b2b_sdi" inherit_id="website_sale.address" name="Show b2b fields SDI" customize_show="True">
        <xpath expr="//div[@id='div_phone']" position="after">
            <t>
                <div t-attf-class="form-group #{error.get('codice_destinatario') and 'o_has_error' or ''} col-lg-6" id="div_codice_destinatario">
                    <label class="col-form-label" for="codice_destinatario">Codice SDI </label>
                    <input type="text" name="codice_destinatario"
                           t-att-readonly="None if not 'codice_destinatario' in checkout else '1'"
                           t-attf-class="form-control #{error.get('codice_destinatario') and 'is-invalid' or ''}"
                           t-att-value="('codice_destinatario' in checkout and checkout['codice_destinatario'] or '0000000').replace('0000000','')"
                           t-att-title="None if website_sale_order.partner_id.company_type in ['company'] else 'For change SDI you have to be a Company, if you are, please contact system Administrator.'"/>
                </div>
            </t>
        </xpath>
    </template>

    <template
        id="portal_my_details"
        name="Add SDI in Portal"
        inherit_id="portal.portal_my_details">

        <xpath expr="//div[hasclass('o_portal_details')]/div[1]/div[1]/div[7]" position="after">
            <t>
                <div t-attf-class="form-group #{error.get('codice_destinatario') and 'o_has_error' or ''} col-xl-6">
                    <label class="col-form-label label-optional" for="codice_destinatario">Codice SDI</label>
                    <input
                        type="text"
                        name="codice_destinatario"
                        t-att-readonly="None if partner.company_type in ['company'] and (not codice_destinatario or not partner.codice_destinatario) else '1'"
                        t-attf-class="form-control #{error.get('codice_destinatario') and 'is-invalid' or ''}"
                        t-att-value="codice_destinatario or partner.codice_destinatario"
                        t-att-title="None if partner.company_type in ['company'] else 'For change SDI you have to be a Company, if you are, please contact system Administrator.'"/>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
