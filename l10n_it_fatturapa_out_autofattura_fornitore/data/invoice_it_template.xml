   <template
        id="template_rpestatore_autof"
        inherit_id="l10n_it_fatturapa_out.account_invoice_it_cedente_prestatore"
    >

       <xpath expr="//CedentePrestatore//DatiAnagrafici" position="before">

                    <t t-if="invoices[0].partner_id.fatturapa_out_autofattura and invoices[0].move_type=='in_invoice'">

                        <t t-set="partner_id" t-value="invoices[0].partner_id"/>
                    </t>
                </xpath>
   </template>
   <template
        id="template_cessionario_autof"
        inherit_id="l10n_it_fatturapa_out.account_invoice_it_cessionario_committente"
    >

  <xpath expr="//CessionarioCommittente//DatiAnagrafici" position="before">
                    <t t-if="invoices[0].partner_id.fatturapa_out_autofattura and invoices[0].move_type=='in_invoice'">
                        <t t-set="partner_id" t-value="company_id.partner_id"/>
                    </t>
                </xpath>
   </template>


