<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_type_form_sign" model="ir.ui.view">
        <field name="name">account.tax.form</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form" />
        <field name="arch" type="xml">
           <xpath expr="//field[@name='tax_group_id']" position="after">
                  <field name="margin_tax"/>
                </xpath>
            <xpath expr="//field[@name='amount']/.." position="after">
                             <label for="orig_percentage" attrs="{'invisible':[('amount_type','not in', ('fixed', 'percent', 'division'))]}"/>
                            <div attrs="{'invisible':[('amount_type','not in', ('fixed', 'percent', 'division'))]}">
                                <field name="orig_percentage" class="oe_inline"/>
                                <span class="o_form_label oe_inline" attrs="{'invisible':[('amount_type','=','fixed')]}">%</span>
                            </div>
            </xpath>
        </field>
    </record>


</odoo>
