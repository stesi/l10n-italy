<odoo>
  <data>
    <record id="sale_order" model="ir.ui.view">
            <field name="name">sale.order.form</field>
            <field name="model">sale.order</field>
      <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
             <xpath expr="//field[@name='order_line']/form/group/group/field[@name='tax_id']" position="before">
                  <field name="margin_tax"/>
                </xpath>
                <xpath expr="//field[@name='order_line']/tree/field[@name='tax_id']" position="before">
                  <field name="margin_tax"/>
                </xpath>
            </field>
        </record>
  </data>
</odoo>
